{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "rootDir": "./",
    "outDir": "./dist",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": "./src",            // <-- esto es clave
    "paths": {
      "@/*": ["*"],                 // <-- alias principal (mantener para compatibilidad)
      "@shared/*": ["shared/*"],    // <-- alias para elementos compartidos
      "@modules/*": ["modules/*"],  // <-- alias para módulos
      "@auth/*": ["modules/auth/*"], // <-- alias específico para auth
      "@products/*": ["modules/products/*"], // <-- alias específico para products
      "@tracks/*": ["modules/tracks/*"], // <-- alias específico para tracks
      "@email/*": ["modules/email/*"], // <-- alias específico para email
      "@images/*": ["modules/images/*"] // <-- alias específico para images
    }
  },
  "include": [
    "index.ts",
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ],
  "ts-node": {
    "require": ["tsconfig-paths/register"]
  }
}
